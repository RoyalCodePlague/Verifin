# Backend (Django) example values only. Do not commit real credentials.
SECRET_KEY=replace-with-a-local-development-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
FRONTEND_URL=http://localhost:8080

# PostgreSQL: set DB_NAME, DB_USER, DB_PASSWORD, DB_HOST and DB_PORT.
# DATABASE_URL takes priority when set. Leave all blank only to use SQLite.
# This workstation uses PostgreSQL on 127.0.0.1:1999.
DATABASE_URL=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Email verification.
# Mailgun HTTP API: use a domain sending key. No SMTP password is needed.
EMAIL_BACKEND=accounts.mailgun_backend.EmailBackend
MAILGUN_API_KEY=
MAILGUN_DOMAIN=mg.verifin.co.zw
MAILGUN_REGION=eu
# Optional SMTP alternative: set EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# Mailgun: use domain SMTP credentials, not your API key or account password.
# EU domains use smtp.eu.mailgun.org. Verify your sending domain in Mailgun.
MAILGUN_SMTP_HOST=
MAILGUN_SMTP_PORT=587
MAILGUN_SMTP_USERNAME=
MAILGUN_SMTP_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_TIMEOUT=20
DEFAULT_FROM_EMAIL=Verifin <no-reply@mg.verifin.co.zw>
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60


# Pesepay configuration
PESEPAY_ENV=sandbox
PESEPAY_INTEGRATION_KEY=
PESEPAY_ENCRYPTION_KEY=
PESEPAY_RESULT_URL=http://localhost:8080/billing
PESEPAY_RETURN_URL=http://localhost:8080/billing

# New accounts: 30 days Business, then free Starter; no automatic charges.
LAUNCH_PROMO_ENABLED=True
BILLING_TEST_MODE=False

# Google Cloud OAuth client, application type: Web application
GOOGLE_CLIENT_ID=

# Other SMTP providers: remove MAILGUN_SMTP_* values before using EMAIL_HOST_*.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.your-provider.example
# EMAIL_HOST_USER=your-provider-smtp-username
# EMAIL_HOST_PASSWORD=your-provider-smtp-password
# DEFAULT_FROM_EMAIL=Verifin <accounts@your-domain.example>
# Port 587: EMAIL_USE_TLS=True, EMAIL_USE_SSL=False
# Port 465: EMAIL_USE_TLS=False, EMAIL_USE_SSL=True
EMAIL_USE_SSL=False
EMAIL_ALLOW_LOCAL_VERIFICATION=False
# Leave zero for direct traffic. Configure your trusted proxy chain explicitly.
AUTH_TRUSTED_PROXY_COUNT=0
